  "description": "Human-first class diagram editor — click-to-add members, live UML relations, no framework. Used standalone or bundled by the artisan-uml CLI.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "layout-constants.mjs",
    "layout-constants.d.mts",
    "layout.mjs",
    "layout.d.mts"
  ],
  "exports": {
